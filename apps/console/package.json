{
  "name": "@expo-lynx/delivery-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:device": "node scripts/dev.mjs --lan",
    "build": "pnpm typecheck && vite build",
    "preview": "pnpm build && wrangler dev --local --port 8787",
    "deploy": "pnpm build && wrangler deploy",
    "test": "node --experimental-strip-types tests/public-delivery.test.ts && node --experimental-strip-types tests/control-api.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "db:migrate:local": "wrangler d1 migrations apply lynx-delivery --local --persist-to .wrangler/delivery-worker-v2",
    "db:reset:local": "node scripts/reset-local.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "exact-mirror": "0.2.7",
    "lucide-react": "1.31.0",
    "openapi-types": "^12.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "^4.127.0"
  },
  "type": "module"
}
