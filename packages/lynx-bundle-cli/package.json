{
  "name": "@expo-lynx/bundle-cli",
  "version": "0.1.0",
  "description": "Build, package, and sign isolated Lynx mini-app releases",
  "type": "module",
  "bin": {
    "lynx-bundle": "./bin/lynx-bundle.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "index.d.ts"
  ],
  "scripts": {
    "build": "node ./scripts/check.mjs",
    "lint": "node ./scripts/check.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "private": true
}
