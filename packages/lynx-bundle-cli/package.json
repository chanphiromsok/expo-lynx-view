{
  "name": "expo-lynx-bundle-cli",
  "version": "0.3.2",
  "description": "Lynx managed delivery.\n\nSTART HERE\n  Mini-app repository: lynx doctor, then lynx release --platform ios\n  Expo host repository: lynx keys generate, lynx doctor, lynx host prepare, then lynx host register\n  Cloudflare owner: lynx console setup --username <name>\n\nRun lynx <command> --help for details.",
  "type": "module",
  "bin": {
    "lynx-bundle": "./bin/lynx-bundle.mjs",
    "lynx": "./bin/lynx.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "bin",
    "examples",
    "src",
    "index.d.ts"
  ],
  "scripts": {
    "build": "node ./scripts/check.mjs",
    "lint": "node ./scripts/check.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "oclif": {
    "bin": "lynx",
    "dirname": "lynx",
    "flexibleTaxonomy": true,
    "commands": {
      "strategy": "explicit",
      "target": "./src/oclif-commands.mjs"
    }
  },
  "dependencies": {
    "@expo/fingerprint": "0.20.10",
    "@oclif/core": "^4.14.0",
    "aws4fetch": "^1.0.20"
  }
}
