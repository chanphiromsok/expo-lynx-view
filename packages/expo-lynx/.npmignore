# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by `npm pack`
/*.tgz

# Never publish local delivery credentials or Worker state.
/.env*
/.local-lynx-*/
/.wrangler/
/keys/
/*.pem
/*.key

__mocks__
__tests__

/babel.config.js
/internal/module_scripts/
/ios/tests/
/android/src/androidTest/
/android/src/test/
/android/build/
/android/.gradle/
/example/
