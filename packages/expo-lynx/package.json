{
  "name": "expo-lynx-view",
  "version": "0.3.5",
  "description": "Embed Lynx views in Expo and React Native apps on iOS and Android",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "EXPO_NONINTERACTIVE=1 expo-module build",
    "clean": "expo-module clean",
    "lint": "eslint src/",
    "test": "jest --runInBand && node --test app.plugin.test.js",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-lynx-view",
    "ExpoLynx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanphiromsok/expo-lynx-view.git"
  },
  "bugs": {
    "url": "https://github.com/chanphiromsok/expo-lynx-view/issues"
  },
  "author": "Rom <chanphiromsok2109@gmail.com> (https://github.com/chanphiromsok)",
  "license": "MIT",
  "homepage": "https://github.com/chanphiromsok/expo-lynx-view#readme",
  "files": [
    "android/src",
    "android/build.gradle",
    "app.plugin.js",
    "build",
    "expo-module.config.json",
    "ios/ExpoLynx.h",
    "ios/*.podspec",
    "ios/Module/*.swift",
    "ios/View/*.swift",
    "ios/Delivery/*.swift",
    "ios/FastImage/*.swift",
    "ios/FastImage/*.h",
    "ios/FastImage/*.m"
  ],
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "57.0.15",
    "expo-module-scripts": "^56.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
