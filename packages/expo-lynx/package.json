{
  "name": "expo-lynx",
  "version": "0.1.0",
  "description": "Embed Lynx views in Expo and React Native apps on iOS",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js && node --test app.plugin.test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-lynx",
    "ExpoLynx"
  ],
  "repository": "https://github.com/chanphiromsok/expo-lynx",
  "bugs": {
    "url": "https://github.com/chanphiromsok/expo-lynx/issues"
  },
  "author": "Rom <chanphiromsok2109@gmail.com> (https://github.com/chanphiromsok)",
  "license": "MIT",
  "homepage": "https://github.com/chanphiromsok/expo-lynx#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "57.0.15",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
