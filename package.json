{
  "name": "expo-lynx-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ios": "pnpm --filter expo-lynx-example ios",
    "android": "pnpm --filter expo-lynx-example android",
    "start": "pnpm --filter expo-lynx-example start",
    "docs": "pnpm --filter @expo-lynx/docs dev",
    "docs:build": "pnpm --filter @expo-lynx/docs build",
    "build": "pnpm --filter expo-lynx-view build && pnpm --filter expo-lynx-bundle-cli build",
    "test": "pnpm --filter expo-lynx-view test && pnpm --filter expo-lynx-bundle-cli test && node --test scripts/release.test.mjs",
    "lint": "pnpm --filter expo-lynx-view lint && pnpm --filter expo-lynx-bundle-cli lint",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish",
    "lynx-bundle": "node packages/lynx-bundle-cli/bin/lynx-bundle.mjs",
    "lynx": "node scripts/lynx.mjs",
    "lynx-delivery": "node scripts/local-lynx-delivery.mjs",
    "test:lynx-delivery": "node scripts/test-local-lynx-delivery.mjs",
    "serve:lynx-local": "node scripts/serve-local-lynx-release.mjs"
  }
}
