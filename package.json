{
  "name": "expo-lynx-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ios": "pnpm --filter expo-lynx-example ios",
    "android": "pnpm --filter expo-lynx-example android",
    "start": "pnpm --filter expo-lynx-example start",
    "build": "pnpm --filter expo-lynx build && pnpm --filter @expo-lynx/bundle-cli build",
    "test": "pnpm --filter expo-lynx test && pnpm --filter @expo-lynx/bundle-cli test",
    "lint": "pnpm --filter expo-lynx lint && pnpm --filter @expo-lynx/bundle-cli lint",
    "lynx-bundle": "node packages/lynx-bundle-cli/bin/lynx-bundle.mjs",
    "lynx-delivery": "node scripts/local-lynx-delivery.mjs",
    "test:lynx-delivery": "node scripts/test-local-lynx-delivery.mjs",
    "sync:example-bundle": "node scripts/sync-lynx-example-bundle.mjs",
    "serve:lynx-local": "node scripts/serve-local-lynx-release.mjs",
    "serve:lynx-remote": "node scripts/serve-local-lynx-release.mjs --dist ../lynx-source/dist",
    "rebuild:lynx-remote": "node scripts/rebuild-lynx-remote.mjs"
  }
}
