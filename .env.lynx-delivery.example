# Copy to .env.lynx-delivery. It is intentionally ignored by Git.
# These values are read only by trusted provisioning/deployment tooling.
# Never add them to app.json, the iOS app, or browser-delivered JavaScript.

# Cloudflare control-plane operations: provision R2/D1, apply D1 migrations,
# inspect releases/channels, and deploy the Worker.
LYNX_DELIVERY_CLOUDFLARE_API_TOKEN=
LYNX_DELIVERY_CLOUDFLARE_ACCOUNT_ID=
LYNX_DELIVERY_CLOUDFLARE_WORKER_NAME=lynx-delivery

# Cloudflare resources created or selected by `pnpm lynx init --cloudflare`.
LYNX_DELIVERY_CLOUDFLARE_R2_BUCKET_NAME=lynx-artifacts
LYNX_DELIVERY_CLOUDFLARE_D1_DATABASE_ID=

# R2 S3-compatible credentials. Store these as Worker secrets so the Worker can
# issue short-lived presigned PUT URLs. The CLI receives only the presigned URL;
# do not copy permanent R2 credentials into the app or browser UI.
LYNX_DELIVERY_CLOUDFLARE_R2_ACCESS_KEY_ID=
LYNX_DELIVERY_CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Public verification material is safe to compile into the iOS app. The private
# signing key stays in the CLI/CI workflow and is intentionally not configured
# for the browser console.
LYNX_DELIVERY_PUBLIC_KEY_PATH=./apps/expo-lynx-example/keys/lynx/updates.public.pem
